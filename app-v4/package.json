{
  "name": "catspace-v4",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:pages": "tsc --noEmit && vite build --outDir ../v4 --emptyOutDir",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.179.0",
    "typescript": "5.9.2",
    "vite": "6.3.6"
  }
}
